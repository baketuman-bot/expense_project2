[Unit]
Description=Gunicorn daemon for expense_project2
After=network.target

[Service]
User=idc_user
Group=idc_user
WorkingDirectory=/home/idc_user/expense_project2
Environment="IMAGE_UP_APP_BASE_URL=https://image-up-app-366939928631.asia-northeast2.run.app"
ExecStart=/home/idc_user/expense_project2/.venv/bin/gunicorn \
    --workers 3 \
    --bind 0.0.0.0:8000 \
    --access-logfile /home/idc_user/expense_project2/logs/gunicorn-access.log \
    --error-logfile  /home/idc_user/expense_project2/logs/gunicorn-error.log \
    expense_project.wsgi:application
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
