[Unit]
Description=Uvicorn daemon for expense_project2
After=network-online.target
Wants=network-online.target

[Service]
User=idc_user
Group=idc_user
WorkingDirectory=/home/idc_user/expense_project2
# DEBUG 未指定だと settings.py は DEBUG=True になるため明示的に 0 を指定する
Environment="DEBUG=0"
Environment="SERVE_MEDIA=1"
Environment="IMAGE_UP_APP_BASE_URL=https://image-up-app-366939928631.asia-northeast2.run.app"
Environment="HTTP_PROXY=http://172.16.100.2:8080"
Environment="HTTPS_PROXY=http://172.16.100.2:8080"
Environment="http_proxy=http://172.16.100.2:8080"
Environment="https_proxy=http://172.16.100.2:8080"
Environment="NO_PROXY=localhost,127.0.0.1,172.16.*.*,<local>"
Environment="no_proxy=localhost,127.0.0.1,172.16.*.*,<local>"
ExecStartPre=/bin/mkdir -p /home/idc_user/expense_project2/logs
ExecStart=/home/idc_user/expense_project2/.venv/bin/uvicorn \
    --workers 3 \
    --host 0.0.0.0 \
    --port 8000 \
    --log-level info \
    --access-log \
    expense_project.asgi:application
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
