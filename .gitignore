# Python 仮想環境
.venv/
venv/
env/

# Python キャッシュ
__pycache__/
*.pyc
*.pyo
*.pyd

# Django collectstatic 出力（ソースは expenses/static/ 以下）
static/staticfiles.json
static/admin/
static/expenses/

# ログ
logs/
*.log

# メディアファイル（アップロードファイルは別途バックアップ推奨）
media/
media_user/

# 秘密情報・認証情報
gcloud_adc.json
*.env
.env
secrets.json

# エディタ・OS
.DS_Store
Thumbs.db
.vscode/
*.swp

# DB（SQLite を使っている場合）
db.sqlite3

# pytest / coverage
.pytest_cache/
htmlcov/
.coverage
.claude/

# git worktree作業ディレクトリ
.worktrees/

deploy/windows_sync/config.ini
deploy/windows_sync/sync_assets.log

# 一時ファイル置き場（gsession_src 等の巨大ファイル・個人情報を含むため git 管理外）
tmp/
deploy/gs2db_sync/*.jar
deploy/gs2db_sync/csv/
deploy/gs2db_sync/work/

# Windows由来のゴミファイル（NTFSのZone.Identifier実体化、コピー時に破損したファイル名等）
# Windowsでは使えない禁止文字（< > : " ? |）を含むファイル名は誤って生成されたゴミの可能性が高く、
# コミットするとWindows側でのcheckoutが失敗するため除外する
*Zone.Identifier*
*[<>:"?|]*
